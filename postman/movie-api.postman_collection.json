    {
      "name": "Delete",
      "item": [
        {
          "name": "Delete an existing movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"The response body is empty\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{newId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{newId}}"]
            }
          }
        },
        {
          "name": "Delete the same movie again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is MOVIE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"MOVIE_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{newId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{newId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Query parameters",
      "item": [
        {
          "name": "Filter by genre (case-insensitive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only Sci-Fi movies\", () => pm.response.json().forEach((m) => pm.expect(m.genre).to.eql(\"Sci-Fi\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=sci-fi",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "genre",
                  "value": "sci-fi"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by genre and year",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only Sci-Fi movies from 2000 onwards\", () => pm.response.json().forEach((m) => { pm.expect(m.genre).to.eql(\"Sci-Fi\"); pm.expect(m.year).to.be.at.least(2000); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=Sci-Fi&minYear=2000",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "genre",
                  "value": "Sci-Fi"
                },
                {
                  "key": "minYear",
                  "value": "2000"
                }
              ]
            }
          }
        },
        {
          "name": "Filter and sort by year",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const years = pm.response.json().map((m) => m.year);",
                  "pm.test(\"Sorted from oldest to newest\", () => pm.expect(years).to.eql([...years].sort((a, b) => a - b)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=Sci-Fi&minYear=2000&sort=year",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "genre",
                  "value": "Sci-Fi"
                },
                {
                  "key": "minYear",
                  "value": "2000"
                },
                {
                  "key": "sort",
                  "value": "year"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by title",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const titles = pm.response.json().map((m) => m.title);",
                  "pm.test(\"Sorted alphabetically\", () => pm.expect(titles).to.eql([...titles].sort((a, b) => a.localeCompare(b, \"en\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?sort=title",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "sort",
                  "value": "title"
                }
              ]
            }
          }
        },
        {
          "name": "No matching movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"An empty array is returned\", () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=Western",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "genre",
                  "value": "Western"
                }
              ]
            }
          }
        },
        {
          "name": "Use an invalid minYear",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is INVALID_QUERY\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_QUERY\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?minYear=invalid",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "minYear",
                  "value": "invalid"
                }
              ]
            }
          }
        },
        {
          "name": "Use an unsupported sort value",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is INVALID_QUERY\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_QUERY\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?sort=rating",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                {
                  "key": "sort",
                  "value": "rating"
                }
              ]
            }
          }
        }
      ]
