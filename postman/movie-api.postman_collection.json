{
  "info": {
    "name": "Movie API (Week 2)",
    "description": "Week 2 test cases for the Node.js + Express Movie API: complete CRUD, validation, query parameters and the fallback middleware. Run the folders in order (Collection Runner). Start the server with npm start first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Read",
      "item": [
        {
          "name": "Get all movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"An array is returned\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": ["{{baseUrl}}"],
              "path": ["movies"]
            }
          }
        },
        {
          "name": "Get one existing movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Movie 1 is returned\", () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/1",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "1"]
            }
          }
        },
        {
          "name": "Get a missing movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is MOVIE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"MOVIE_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/999",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "999"]
            }
          }
        }
      ]
    },
    {
      "name": "Create",
      "item": [
        {
          "name": "Create a valid movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const movie = pm.response.json();",
                  "pm.test(\"The server created an id\", () => pm.expect(movie.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"newId\", movie.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": ["{{baseUrl}}"],
              "path": ["movies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Arrival\",\n  \"year\": 2016,\n  \"genre\": \"Sci-Fi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create an invalid movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"Validation details are returned\", () => pm.expect(pm.response.json().error.details).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": ["{{baseUrl}}"],
              "path": ["movies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"year\": \"not a number\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Body that is not valid JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Error code is INVALID_JSON\", () => pm.expect(pm.response.json().error.code).to.eql(\"INVALID_JSON\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": ["{{baseUrl}}"],
              "path": ["movies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Oops\",",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
