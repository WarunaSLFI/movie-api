              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT a movie that does not exist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is MOVIE_NOT_FOUND\", () => pm.expect(pm.response.json().error.code).to.eql(\"MOVIE_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/999",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "999"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ghost\",\n  \"year\": 1990,\n  \"genre\": \"Drama\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Update (PATCH)",
      "item": [
        {
          "name": "Partially update a movie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only year changes\", () => pm.expect(pm.response.json()).to.eql({ id: 2, title: \"The Matrix\", year: 2000, genre: \"Sci-Fi\" }));"
                ]
              }
            }
          ],
          "request": {
